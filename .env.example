# Supabase Configuration
# Get these from your Supabase project settings: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Service Role Key (server-only, bypasses RLS)
# NEVER expose this in client-side code - only use in server components/API routes
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zoom Integration (Phase 7 - Optional, not required for Phase 5)
# Only needed when implementing Zoom OAuth for automatic meeting creation
# ZOOM_CLIENT_ID=your_zoom_oauth_client_id
# ZOOM_CLIENT_SECRET=your_zoom_oauth_client_secret
# ZOOM_REDIRECT_URI=http://localhost:3000/api/auth/zoom/callback
# ZOOM_WEBHOOK_SECRET=your_zoom_webhook_verification_token

# Email Integration (Phase 7 - Optional)
# Only needed when implementing Resend for event reminder emails
# RESEND_API_KEY=your_resend_api_key

# Cron Job Security (Phase 7 - Optional)
# Only needed when setting up Vercel cron jobs for event reminders
# CRON_SECRET=your_random_secure_secret_for_cron_verification
# Stripe Configuration (Phase 4)
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
# Use test mode keys for development (pk_test_... and sk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
